# Copy to .env in this folder (branch/la2028/.env) and fill in values.
# Never commit .env.

# Required: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional: multimodal model for screenshot OCR/structured extraction (vision).
# Default in script is gpt-4o if unset. Use a newer id if your account supports it (e.g. gpt-4.1, gpt-5.2).
OPENAI_MODEL=gpt-5.4-mini
